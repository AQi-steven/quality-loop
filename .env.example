# ── 千里行配置样例 ── 复制为 .env 后按需修改

# JWT 签名密钥（必填，生产环境务必改为随机长字符串）
JWT_SECRET=please-change-me-to-a-long-random-string

# 服务端口
PORT=3000

# 初始密码策略（默认密码由配置读取，不在代码中）
# PASSWORD_DEFAULT=ChangeMe123!

# ── 库问答 AI（可选）──
# 任意 OpenAI 兼容网关均可（TokenHub / OpenAI / 本地 vLLM 等）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# 备用模型链：主模型失败（额度用尽/超时）自动依次切换，逗号分隔
LLM_FALLBACK_MODELS=

# ── IMA 知识库同步（可选）──
IMA_CLIENT_ID=
IMA_API_KEY=
# IMA 失效告警的 Server酱 SendKey（可选）
IMA_ALERT_SCKEY=

# ── 超级管理员（重要）──
# 代码中所有超管判断的用户名为示例值 'superadmin'，全局搜索可定位全部位置；
# 生产部署建议改为环境变量读取。创建管理员时 username 填此值。
